/**
 * we-aigo Cloudflare Worker - DeepSeek API 代理
 * 功能：
 * 1. POST /execute - 接收任务执行请求
 * 2. GET/POST /api/auto-execute - 自动执行过期未认领任务
 * 3. 调用 DeepSeek API 执行任务
 * 4. 将结果写入 Supabase deliveries 表
 * 5. 更新 tasks 表状态
 */

// 定时器超时设置（60秒）
const TIMEOUT_MS = 60000;

// 根据用户消息生成真实搜索链接
function generateSearchLinks(message: string): Array<{label: string, url: string}> {
  const links: Array<{label: string, url: string}> = [];
  const msg = message.toLowerCase();
  
  // 提取关键词（去掉常见虚词）
  const keywords = message.replace(/[的了吗呢啊吧呀哈哦嗯我想买要找搜索帮我推荐一下给我]/g, '').trim();
  const encodedKeywords = encodeURIComponent(keywords);
  
  // 购物相关
  if (msg.match(/买|购|价|便宜|优惠|折扣|券|满减|凑单|淘宝|京东|拼多多|商品|耳机|手机|电脑|衣服|鞋|包|零食|化妆品/)) {
    links.push({ label: '京东搜索', url: `https://search.jd.com/Search?keyword=${encodedKeywords}` });
    links.push({ label: '淘宝搜索', url: `https://s.taobao.com/search?q=${encodedKeywords}` });
    links.push({ label: '拼多多搜索', url: `https://mobile.yangkeduo.com/search_result.html?search_key=${encodedKeywords}` });
    if (msg.match(/券|优惠券|隐藏券/)) {
      links.push({ label: '京东领券中心', url: 'https://a.jd.com/' });
      links.push({ label: '淘宝优惠券', url: 'https://taobao.quanmama.com/' });
    }
  }
  
  // 奶茶/咖啡
  if (msg.match(/奶茶|喜茶|奈雪|蜜雪|茶百道|古茗|咖啡|星巴克|瑞幸|库迪/)) {
    const brand = msg.match(/喜茶|奈雪|蜜雪|茶百道|古茗|星巴克|瑞幸|库迪/)?.[0] || '';
    if (brand) {
      links.push({ label: `${brand}优惠券`, url: `https://search.jd.com/Search?keyword=${encodeURIComponent(brand + '优惠券')}` });
    }
    links.push({ label: '美团奶茶优惠', url: 'https://h5.waimai.meituan.com/waimai/mindex/home' });
    links.push({ label: '大众点评奶茶', url: `https://m.dianping.com/searchlist?keyword=${encodeURIComponent(brand || '奶茶')}` });
  }
  
  // 加油
  if (msg.match(/加油|汽油|92|95|98|油站|油价/)) {
    links.push({ label: '团油加油优惠', url: 'https://m.czb365.com/' });
    links.push({ label: '今日油价查询', url: 'https://m.qiyoujiage.com/' });
    links.push({ label: '滴滴加油', url: 'https://api.didiglobal.com/' });
  }
  
  // 电影票
  if (msg.match(/电影|票|影院|排座|哪吒|热辣|飞驰/)) {
    links.push({ label: '猫眼电影', url: 'https://maoyan.com/films' });
    links.push({ label: '淘票票', url: 'https://dianying.taobao.com/' });
    links.push({ label: '美团电影', url: 'https://i.meituan.com/awp/h5/dianying/movie' });
  }
  
  // 餐饮/聚餐
  if (msg.match(/聚餐|餐厅|吃饭|美食|外卖|火锅|烧烤|川菜|粤菜/)) {
    links.push({ label: '美团美食', url: 'https://h5.waimai.meituan.com/waimai/mindex/home' });
    links.push({ label: '大众点评', url: `https://m.dianping.com/searchlist?keyword=${encodeURIComponent(keywords)}` });
    links.push({ label: '饿了么', url: 'https://h5.ele.me/' });
  }
  
  // 如果没有匹配到特定场景，提供通用搜索链接
  if (links.length === 0 && keywords.length > 0) {
    links.push({ label: '京东搜索', url: `https://search.jd.com/Search?keyword=${encodedKeywords}` });
    links.push({ label: '淘宝搜索', url: `https://s.taobao.com/search?q=${encodedKeywords}` });
  }
  
  return links;
}

// 从用户消息提取搜索关键词（供Serper使用）
function extractSearchQuery(message: string): string {
  // 去掉常见虚词和指令性词语
  const cleaned = message
    .replace(/帮我|我想|请|能不能|可以|一下|推荐|搜索|找找|看看/g, '')
    .replace(/[的了吗呢啊吧呀哈哦嗯]/g, '')
    .trim();
  
  // 如果太短则不搜索
  if (cleaned.length < 2) return '';
  
  // 加上"优惠"后缀提高搜索精准度
  return cleaned + ' 优惠 价格';
}

// 根据任务标题和描述推断任务类型
function inferTaskType(title: string, description: string): string {
  const text = `${title} ${description}`.toLowerCase();
  
  if (text.includes('翻译') || text.includes('英文') || text.includes('英语') || text.includes('外文')) {
    return '翻译润色';
  }
  if (text.includes('学习') || text.includes('辅导') || text.includes('教学') || text.includes('考试') || text.includes('课程')) {
    return '学习辅导';
  }
  if (text.includes('分析') || text.includes('数据') || text.includes('报告') || text.includes('统计')) {
    return '数据分析';
  }
  if (text.includes('创作') || text.includes('写作') || text.includes('文章') || text.includes('文案') || text.includes('诗')) {
    return '内容创作';
  }
  
  return '搜索整理';
}

// 根据任务类型获取系统提示词
function getSystemPrompt(taskType: string): string {
  const prompts: Record<string, string> = {
    '搜索整理': `你是一个专业的信息搜索和整理助手。用户会给你一个任务描述，你需要：
1. 理解用户需求
2. 基于你的知识库，搜索和整理相关信息
3. 提供结构化的、有价值的答案
4. 包含关键信息点、来源链接（如果适用）
5. 使用清晰的格式输出

请用中文回复，格式清晰，重点突出。`,

    '内容创作': `你是一个专业的内容创作助手。用户会给你一个创作需求，你需要：
1. 理解创作目标和受众
2. 创作高质量、有创意的原创内容
3. 内容要有逻辑性、可读性
4. 根据内容类型调整风格

请用中文创作，内容完整、有价值。`,

    '数据分析': `你是一个专业的数据分析助手。用户会给你一个数据分析任务，你需要：
1. 理解数据和分析目标
2. 提供数据分析思路和方法
3. 解释数据洞察和趋势
4. 给出建议和结论

请用中文回复，分析要专业、逻辑清晰。`,

    '翻译润色': `你是一个专业的翻译和文字润色助手。用户会给你一段文字，你需要：
1. 准确翻译（如需要）
2. 优化语言表达
3. 提升文字质量
4. 保持原意和风格

请用中文回复，翻译/润色结果要专业、自然。`,

    '学习辅导': `你是一个耐心的学习辅导老师。用户会给你一个学习问题，你需要：
1. 理解问题核心
2. 用通俗易懂的方式解释
3. 给出例子帮助理解
4. 提供学习建议

请用中文回复，讲解要清晰、有耐心。`
  };

  return prompts[taskType] || prompts['搜索整理'];
}

// 调用 DeepSeek API
async function callDeepSeek(
  apiKey: string,
  baseUrl: string,
  systemPrompt: string,
  userMessage: string
): Promise<string> {
  const url = `${baseUrl}/chat/completions`;
  
  const response = await Promise.race([
    fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${apiKey}`
      },
      body: JSON.stringify({
        model: 'deepseek-chat',
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: userMessage }
        ],
        max_tokens: 4000,
        temperature: 0.7
      })
    }),
    new Promise<never>((_, reject) => 
      setTimeout(() => reject(new Error('API 请求超时')), TIMEOUT_MS - 1000)
    )
  ]);

  if (!response.ok) {
    const errorText = await response.text();
    throw new Error(`DeepSeek API 错误: ${response.status} - ${errorText}`);
  }

  const data = await response.json() as { choices: Array<{ message: { content: string } }> };
  
  if (!data.choices || data.choices.length === 0) {
    throw new Error('DeepSeek API 返回空响应');
  }

  return data.choices[0].message.content;
}

// 调用 Supabase REST API（使用 service_role key）
async function supabaseRequest(
  url: string,
  serviceRoleKey: string,
  options: RequestInit = {}
): Promise<Response> {
  const response = await fetch(url, {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      'apikey': serviceRoleKey,
      'Authorization': `Bearer ${serviceRoleKey}`,
      ...options.headers
    }
  });
  return response;
}

// 更新任务状态
async function updateTaskStatus(
  supabaseUrl: string,
  serviceRoleKey: string,
  taskId: number,
  status: string,
  claimedBy?: number[]
): Promise<void> {
  const url = `${supabaseUrl}/rest/v1/tasks?id=eq.${taskId}`;
  
  const updateData: any = { 
    status,
    completed_at: status === 'completed' ? new Date().toISOString() : null
  };
  
  // 如果指定了claimed_by，更新认领者
  if (claimedBy !== undefined) {
    updateData.claimed_by = claimedBy;
  }
  
  const response = await supabaseRequest(url, serviceRoleKey, {
    method: 'PATCH',
    body: JSON.stringify(updateData)
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`更新任务状态失败: ${error}`);
  }
}

// 创建交付物记录
async function createDelivery(
  supabaseUrl: string,
  serviceRoleKey: string,
  taskId: number,
  agentId: number,
  content: string
): Promise<void> {
  const url = `${supabaseUrl}/rest/v1/deliveries`;
  
  const response = await supabaseRequest(url, serviceRoleKey, {
    method: 'POST',
    body: JSON.stringify({
      task_id: taskId,
      agent_id: agentId,
      content: content,
      submitted_at: new Date().toISOString()
    })
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`创建交付物失败: ${error}`);
  }
}

// 执行单个任务
async function executeSingleTask(
  supabaseUrl: string,
  supabaseServiceKey: string,
  deepseekApiKey: string,
  deepseekBaseUrl: string,
  task: any
): Promise<{ success: boolean; taskId: number; error?: string }> {
  const { id, title, description } = task;
  
  try {
    // 获取任务类型并生成系统提示词
    const taskType = inferTaskType(title, description || '');
    const systemPrompt = getSystemPrompt(taskType);
    const userMessage = `任务标题: ${title}\n\n任务描述: ${description || '无详细描述'}`;
    
    console.log(`[Auto-Execute] 开始执行任务 #${id}: ${title}`);
    console.log(`[Auto-Execute] 推断任务类型: ${taskType}`);
    
    // 调用 DeepSeek API 执行任务
    const result = await callDeepSeek(deepseekApiKey, deepseekBaseUrl, systemPrompt, userMessage);
    
    console.log(`[Auto-Execute] 任务 #${id} 执行完成`);
    
    // 平台AI的agent_id设为0
    const platformAgentId = 0;
    
    // 将结果写入 deliveries 表
    await createDelivery(supabaseUrl, supabaseServiceKey, id, platformAgentId, result);
    
    // 更新任务状态为 completed，claimed_by 设为 [0] 表示平台AI执行
    await updateTaskStatus(supabaseUrl, supabaseServiceKey, id, 'completed', [0]);
    
    console.log(`[Auto-Execute] 任务 #${id} 已标记为完成`);
    
    return { success: true, taskId: id };
  } catch (error) {
    const errorMsg = error instanceof Error ? error.message : '未知错误';
    console.error(`[Auto-Execute] 任务 #${id} 执行失败:`, errorMsg);
    return { success: false, taskId: id, error: errorMsg };
  }
}

// 自动执行过期未认领任务
async function autoExecuteTasks(env: any): Promise<{ executed: number; failed: number; errors: string[] }> {
  const supabaseUrl = env.SUPABASE_URL;
  const supabaseServiceKey = env.SUPABASE_SERVICE_KEY;
  const deepseekApiKey = env.DEEPSEEK_API_KEY;
  const deepseekBaseUrl = env.DEEPSEEK_API_BASE || 'https://api.deepseek.com';

  if (!supabaseUrl || !supabaseServiceKey || !deepseekApiKey) {
    throw new Error('环境变量配置不完整');
  }

  console.log('[Auto-Execute] 开始检查待自动执行的任务...');
  
  // 查询所有 status='open' AND auto_execute_at < now() 的任务
  const queryUrl = `${supabaseUrl}/rest/v1/tasks?status=eq.open&auto_execute_at=lt.now()`;
  
  const response = await supabaseRequest(queryUrl, supabaseServiceKey);
  
  if (!response.ok) {
    const error = await response.text();
    throw new Error(`查询待执行任务失败: ${error}`);
  }
  
  const tasks = await response.json() as any[];
  
  if (!tasks || tasks.length === 0) {
    console.log('[Auto-Execute] 没有需要自动执行的任务');
    return { executed: 0, failed: 0, errors: [] };
  }
  
  console.log(`[Auto-Execute] 找到 ${tasks.length} 个待执行任务`);
  
  let executed = 0;
  let failed = 0;
  const errors: string[] = [];
  
  // 逐个执行任务
  for (const task of tasks) {
    const result = await executeSingleTask(
      supabaseUrl,
      supabaseServiceKey,
      deepseekApiKey,
      deepseekBaseUrl,
      task
    );
    
    if (result.success) {
      executed++;
    } else {
      failed++;
      if (result.error) {
        errors.push(`任务 #${result.taskId}: ${result.error}`);
      }
    }
  }
  
  console.log(`[Auto-Execute] 执行完成: 成功 ${executed}, 失败 ${failed}`);
  
  return { executed, failed, errors };
}

// 处理自动执行请求（HTTP端点）
async function handleAutoExecuteRequest(request: Request, env: any): Promise<Response> {
  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  };

  // 处理 CORS 预检
  if (request.method === 'OPTIONS') {
    return new Response(null, { headers: corsHeaders });
  }

  try {
    const result = await autoExecuteTasks(env);
    
    return new Response(
      JSON.stringify({
        success: true,
        timestamp: new Date().toISOString(),
        ...result
      }),
      { status: 200, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    );
  } catch (error) {
    console.error('[Auto-Execute] 自动执行出错:', error);
    
    return new Response(
      JSON.stringify({
        success: false,
        error: error instanceof Error ? error.message : '未知错误',
        timestamp: new Date().toISOString()
      }),
      { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    );
  }
}

// 处理定时触发（Cloudflare Cron）
async function handleScheduled(env: any): Promise<void> {
  console.log('[Cron] 定时任务触发，开始检查待自动执行的任务...');
  
  try {
    const result = await autoExecuteTasks(env);
    console.log('[Cron] 定时任务完成:', result);
  } catch (error) {
    console.error('[Cron] 定时任务执行失败:', error);
  }
}

// 执行任务的主要函数
async function executeTask(request: Request, env: any): Promise<Response> {
  const body = await request.json() as {
    taskId?: number;
    title?: string;
    description?: string;
    taskType?: string;
  };

  const { taskId, title, description, taskType } = body;

  // 验证必填参数
  if (!taskId || !title || !description) {
    return new Response(
      JSON.stringify({ error: '缺少必填参数: taskId, title, description' }),
      { status: 400, headers: { 'Content-Type': 'application/json' } }
    );
  }

  // 获取环境变量
  const deepseekApiKey = env.DEEPSEEK_API_KEY;
  const supabaseUrl = env.SUPABASE_URL;
  const supabaseServiceKey = env.SUPABASE_SERVICE_KEY;
  const deepseekBaseUrl = env.DEEPSEEK_API_BASE || 'https://api.deepseek.com';

  if (!deepseekApiKey || !supabaseUrl || !supabaseServiceKey) {
    return new Response(
      JSON.stringify({ error: '服务端配置不完整' }),
      { status: 500, headers: { 'Content-Type': 'application/json' } }
    );
  }

  // 获取系统提示词（优先使用传入的任务类型，否则自动推断）
  const taskTypeFinal = taskType || inferTaskType(title, description);
  const systemPrompt = getSystemPrompt(taskTypeFinal);

  // 构建用户消息
  const userMessage = `任务标题: ${title}\n\n任务描述: ${description}`;

  // 调用 DeepSeek API 执行任务
  console.log(`[Worker] 开始执行任务 #${taskId}: ${title}`);
  console.log(`[Worker] 推断任务类型: ${taskTypeFinal}`);
  
  const result = await callDeepSeek(deepseekApiKey, deepseekBaseUrl, systemPrompt, userMessage);
  
  console.log(`[Worker] 任务 #${taskId} 执行完成`);
  
  // 模拟匹配一个 agent（实际应用中应该根据任务类型匹配）
  const agentId = 1;

  // 将结果写入 deliveries 表
  await createDelivery(supabaseUrl, supabaseServiceKey, taskId, agentId, result);

  // 更新任务状态为 completed
  await updateTaskStatus(supabaseUrl, supabaseServiceKey, taskId, 'completed');

  console.log(`[Worker] 任务 #${taskId} 已标记为完成`);

  // 返回成功结果
  return new Response(
    JSON.stringify({
      success: true,
      taskId,
      result,
      taskType: taskTypeFinal,
      message: '任务执行完成'
    }),
    { status: 200, headers: { 'Content-Type': 'application/json' } }
  );
}

// 主请求处理
async function handleRequest(request: Request, env: any): Promise<Response> {
  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  };

  // 处理 CORS 预检
  if (request.method === 'OPTIONS') {
    return new Response(null, { headers: corsHeaders });
  }

  // 解析 URL
  const url = new URL(request.url);
  const path = url.pathname;

  // Token API 路由
  if (path.startsWith('/api/token/')) {
    try {
      return await handleTokenApi(request, env);
    } catch (error) {
      console.error('[Token API] 错误:', error);
      return new Response(
        JSON.stringify({ success: false, error: error instanceof Error ? error.message : '未知错误' }),
        { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      );
    }
  }

  // 管理员初始化数据库表
  if (path === '/admin/init-tables' && request.method === 'POST') {
    try {
      const supabaseUrl = env.SUPABASE_URL;
      const serviceRoleKey = env.SUPABASE_SERVICE_KEY;

      // 使用Supabase REST API创建表（通过插入元数据触发表创建）
      // 实际上Supabase REST API不能直接创建表，这里我们通过pg_net扩展发起请求
      
      // 先尝试检查表是否存在
      const checkUrl = `${supabaseUrl}/rest/v1/token_transactions?select=id&limit=1`;
      const checkRes = await supabaseRequest(checkUrl, serviceRoleKey, { method: 'GET' });
      
      if (checkRes.ok) {
        return new Response(JSON.stringify({ success: true, message: '表已存在' }), {
          headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 表不存在，返回创建提示
      return new Response(JSON.stringify({
        success: false,
        message: '需要手动创建表。请在Supabase后台执行以下SQL:',
        sql: [
          'CREATE TABLE IF NOT EXISTS token_transactions (id SERIAL PRIMARY KEY, user_id INTEGER, amount INTEGER NOT NULL, type VARCHAR(50) NOT NULL, description TEXT, related_task_id INTEGER, created_at TIMESTAMPTZ DEFAULT NOW());',
          'CREATE TABLE IF NOT EXISTS token_redemptions (id SERIAL PRIMARY KEY, user_id INTEGER, item_name VARCHAR(100) NOT NULL, cost INTEGER NOT NULL, status VARCHAR(20) DEFAULT \'pending\', created_at TIMESTAMPTZ DEFAULT NOW());'
        ]
      }), {
        headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (error) {
      return new Response(JSON.stringify({ success: false, error: String(error) }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // 处理 /execute 路由
  if (path === '/execute' && request.method === 'POST') {
    try {
      return await executeTask(request, env);
    } catch (error) {
      console.error('[Worker] 执行错误:', error);
      
      return new Response(
        JSON.stringify({
          success: false,
          error: error instanceof Error ? error.message : '未知错误'
        }),
        { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      );
    }
  }

  // 自动执行端点
  if (path === '/api/auto-execute' && (request.method === 'GET' || request.method === 'POST')) {
    return handleAutoExecuteRequest(request, env);
  }

  // 数据库管理端点（用于执行DDL）
  if (path === '/api/admin/db' && request.method === 'POST') {
    const supabaseUrl = env.SUPABASE_URL;
    const supabaseServiceKey = env.SUPABASE_SERVICE_KEY;
    
    if (!supabaseUrl || !supabaseServiceKey) {
      return new Response(JSON.stringify({ error: '配置不完整' }), { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
    }
    
    try {
      const body = await request.json() as { sql: string };
      if (!body.sql) {
        return new Response(JSON.stringify({ error: '缺少sql参数' }), { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
      }
      
      // 通过PostgREST执行DDL（使用service_role key）
      // 注意：PostgREST不支持DDL，需要使用Supabase Management API
      // 这里我们通过REST API直接操作数据
      console.log('[Admin] 执行SQL:', body.sql);
      
      // 检查是否是添加字段操作
      if (body.sql.includes('ADD COLUMN') && body.sql.includes('auto_execute_at')) {
        // 先检查字段是否已存在
        const checkUrl = `${supabaseUrl}/rest/v1/tasks?select=id&limit=1`;
        const checkRes = await supabaseRequest(checkUrl, supabaseServiceKey);
        
        // 由于PostgREST不能直接添加列，我们需要告知用户通过Supabase Dashboard执行
        return new Response(JSON.stringify({
          success: false,
          error: 'DDL操作需要通过Supabase Dashboard或Management API执行',
          hint: '请在Supabase Dashboard -> SQL Editor中执行: ALTER TABLE tasks ADD COLUMN IF NOT EXISTS auto_execute_at TIMESTAMPTZ;',
          sql: body.sql
        }), { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
      }
      
      return new Response(JSON.stringify({ error: '不支持的操作' }), { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
    } catch (error) {
      return new Response(JSON.stringify({ error: error instanceof Error ? error.message : '未知错误' }), { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
    }
  }

  // AI 聊天接口 - 带智能链接生成
  if (path === '/chat' && request.method === 'POST') {
    try {
      const body = await request.json() as { messages: Array<{role: string, content: string}>, stream?: boolean, temperature?: number, max_tokens?: number };
      if (!body.messages || !Array.isArray(body.messages)) {
        return new Response(JSON.stringify({ error: 'Missing messages' }), { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
      }

      // 获取用户最后一条消息
      const lastUserMsg = body.messages.filter(m => m.role === 'user').pop()?.content || '';
      
      // 生成真实搜索链接
      const searchLinks = generateSearchLinks(lastUserMsg);
      
      // 构建增强的系统提示词
      const linkContext = searchLinks.length > 0 
        ? `\n\n【可参考的真实链接（必须在回复中包含这些链接）】：\n${searchLinks.map(l => `- ${l.label}: ${l.url}`).join('\n')}`
        : '';
      
      const enhancedSystemPrompt = `你是AI省钱助手，帮用户找到最优惠的方案。
【回复铁律】：
1. 100字以内，直接给结果
2. 如果有搜索链接，附上搜索链接（如京东搜索、淘宝搜索等）
3. 禁止编造任何商品链接和优惠券链接（如3.cn、jd.com商品页等都是假的）
4. 禁止说"去XX APP搜"，禁止教程式回复
5. 告诉用户"福利群有真实优惠券，可直接领取"${linkContext}`;

      // 构建消息列表
      const enhancedMessages = [
        { role: 'system', content: enhancedSystemPrompt },
        ...body.messages
      ];

      const deepseekUrl = `${env.DEEPSEEK_API_BASE || 'https://api.deepseek.com'}/chat/completions`;
      
      // 尝试使用Serper搜索（如果API key已配置）
      let serperContext = '';
      if (env.SERPER_API_KEY) {
        try {
          const searchQuery = extractSearchQuery(lastUserMsg);
          if (searchQuery) {
            const serperResp = await fetch('https://google.serper.dev/search', {
              method: 'POST',
              headers: { 'X-API-KEY': env.SERPER_API_KEY, 'Content-Type': 'application/json' },
              body: JSON.stringify({ q: searchQuery, gl: 'cn', hl: 'zh-cn', num: 5 })
            });
            if (serperResp.ok) {
              const serperData = await serperResp.json() as any;
              if (serperData.organic?.length > 0) {
                serperContext = '\n\n【实时搜索结果（优先使用这些链接）】：\n' + 
                  serperData.organic.slice(0, 5).map((r: any) => `- ${r.title}: ${r.link}`).join('\n');
              }
            }
          }
        } catch (e) {
          console.log('[Chat] Serper search failed, using fallback:', e);
        }
      }
      
      // 如果有Serper结果，追加到系统提示
      if (serperContext) {
        enhancedMessages[0].content += serperContext;
      }

      const deepseekBody = {
        model: 'deepseek-chat',
        messages: enhancedMessages,
        stream: false,
        temperature: body.temperature || 0.7,
        max_tokens: body.max_tokens || 300,
      };

      const deepseekResponse = await fetch(deepseekUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${env.DEEPSEEK_API_KEY}`,
        },
        body: JSON.stringify(deepseekBody),
      });

      if (!deepseekResponse.ok) {
        const errText = await deepseekResponse.text();
        return new Response(JSON.stringify({ error: `DeepSeek API error: ${deepseekResponse.status}`, detail: errText }), { status: deepseekResponse.status, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
      }

      const result = await deepseekResponse.json();
      let content = result.choices?.[0]?.message?.content || '抱歉，暂时无法获取回复';
      
      // 从福利群(coupons表)查找匹配的优惠券，替代搜索链接
      try {
        const couponRes = await fetch(`${env.SUPABASE_URL}/rest/v1/coupons?is_active=eq.true&select=title,coupon_url,category,discount_info&limit=3`, {
          headers: { 'apikey': env.SUPABASE_SERVICE_KEY, 'Authorization': `Bearer ${env.SUPABASE_SERVICE_KEY}` }
        });
        if (couponRes.ok) {
          const coupons = await couponRes.json() as any[];
          if (coupons.length > 0) {
            content += '\n\n🎁 福利群可直接领：' + coupons.map(c => `${c.title}(${c.discount_info})`).join('、');
          }
        }
      } catch (e) {}
      
      return new Response(JSON.stringify({ success: true, content, model: result.model }), { headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
    } catch (error) {
      return new Response(JSON.stringify({ error: error instanceof Error ? error.message : String(error) }), { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
    }
  }

// ============ Token 激励系统 ============

// 获取用户Token余额 - 从users表读取
async function getTokenBalance(userId: number, supabaseUrl: string, serviceRoleKey: string): Promise<number> {
  // 优先从users表读取token_balance
  const userUrl = `${supabaseUrl}/rest/v1/users?id=eq.${userId}&select=token_balance`;
  const userResponse = await supabaseRequest(userUrl, serviceRoleKey, { method: 'GET' });
  
  if (userResponse.ok) {
    const users = await userResponse.json() as Array<{ token_balance: number }>;
    if (users.length > 0 && users[0].token_balance > 0) {
      return users[0].token_balance;
    }
  }
  
  // fallback: 从token_transactions表计算
  const url = `${supabaseUrl}/rest/v1/token_transactions?user_id=eq.${userId}&select=amount`;
  const response = await supabaseRequest(url, serviceRoleKey, { method: 'GET' });
  
  if (!response.ok) {
    return 0;
  }
  
  const transactions = await response.json() as Array<{ amount: number }>;
  return transactions.reduce((sum, t) => sum + t.amount, 0);
}

// 添加Token交易记录
async function addTokenTransaction(
  userId: number,
  amount: number,
  type: string,
  description: string,
  relatedTaskId: number | undefined,
  supabaseUrl: string,
  serviceRoleKey: string
): Promise<{ success: boolean; newBalance: number }> {
  const insertUrl = `${supabaseUrl}/rest/v1/token_transactions`;
  const insertData = {
    user_id: userId,
    amount: amount,
    type: type,
    description: description,
    related_task_id: relatedTaskId || null,
    created_at: new Date().toISOString()
  };

  try {
    const response = await supabaseRequest(insertUrl, serviceRoleKey, {
      method: 'POST',
      body: JSON.stringify(insertData)
    });

    if (!response.ok) {
      console.error('[Token] 添加交易记录失败:', await response.text());
      return { success: false, newBalance: 0 };
    }

    const newBalance = await getTokenBalance(userId, supabaseUrl, serviceRoleKey);
    return { success: true, newBalance };
  } catch (e) {
    console.error('[Token] 添加交易异常:', e);
    return { success: false, newBalance: 0 };
  }
}

// 获取Token交易历史
async function getTokenHistory(userId: number, supabaseUrl: string, serviceRoleKey: string): Promise<any[]> {
  const url = `${supabaseUrl}/rest/v1/token_transactions?user_id=eq.${userId}&order=created_at.desc&limit=50`;
  const response = await supabaseRequest(url, serviceRoleKey, { method: 'GET' });
  
  if (!response.ok) {
    return [];
  }
  
  return response.json() as any[];
}

// Token API处理器
async function handleTokenApi(request: Request, env: any): Promise<Response> {
  const url = new URL(request.url);
  const path = url.pathname;
  const supabaseUrl = env.SUPABASE_URL;
  const serviceRoleKey = env.SUPABASE_SERVICE_KEY;

  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  };

  // GET /api/token/balance?user_id=X
  if (path === '/api/token/balance' && request.method === 'GET') {
    const userId = parseInt(url.searchParams.get('user_id') || '0');
    if (!userId) {
      return new Response(JSON.stringify({ error: '缺少user_id参数' }), {
        status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
    
    const balance = await getTokenBalance(userId, supabaseUrl, serviceRoleKey);
    return new Response(JSON.stringify({ success: true, userId, balance }), {
      headers: { ...corsHeaders, 'Content-Type': 'application/json' }
    });
  }

  // POST /api/token/earn
  if (path === '/api/token/earn' && request.method === 'POST') {
    try {
      const body = await request.json() as {
        user_id: number;
        type: string;
        description?: string;
        related_task_id?: number;
      };
      
      if (!body.user_id || !body.type) {
        return new Response(JSON.stringify({ error: '缺少必填参数' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 根据类型计算奖励金额
      const amountMap: Record<string, { min: number; max: number }> = {
        'ai_chat': { min: 10, max: 30 },
        'share_coupon': { min: 20, max: 50 },
        'invite_friend': { min: 100, max: 100 },
        'weekly_task': { min: 15, max: 50 },
        'first_use': { min: 20, max: 20 },
      };
      
      const range = amountMap[body.type] || { min: 10, max: 20 };
      const amount = Math.floor(Math.random() * (range.max - range.min + 1)) + range.min;
      
      const result = await addTokenTransaction(
        body.user_id,
        amount,
        body.type,
        body.description || `获得省钱币奖励`,
        body.related_task_id,
        supabaseUrl,
        serviceRoleKey
      );
      
      return new Response(JSON.stringify({
        success: result.success,
        earned: amount,
        newBalance: result.newBalance,
        message: result.success ? `恭喜获得 +${amount} 省钱币！` : '奖励发放失败'
      }), {
        headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: '请求格式错误' }), {
        status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // POST /api/token/redeem
  if (path === '/api/token/redeem' && request.method === 'POST') {
    try {
      const body = await request.json() as {
        user_id: number;
        item_name: string;
        cost: number;
      };
      
      if (!body.user_id || !body.item_name || !body.cost) {
        return new Response(JSON.stringify({ error: '缺少必填参数' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 检查余额
      const balance = await getTokenBalance(body.user_id, supabaseUrl, serviceRoleKey);
      
      if (balance < body.cost) {
        return new Response(JSON.stringify({
          success: false,
          message: `余额不足，需要${body.cost}省钱币，当前${balance}省钱币`,
          newBalance: balance
        }), {
          headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 核销
      const result = await addTokenTransaction(
        body.user_id,
        -body.cost,
        'redeem',
        `兑换: ${body.item_name}`,
        undefined,
        supabaseUrl,
        serviceRoleKey
      );
      
      if (!result.success) {
        return new Response(JSON.stringify({ success: false, message: '核销失败，请重试', newBalance: balance }), {
          headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 记录兑换
      await supabaseRequest(`${supabaseUrl}/rest/v1/token_redemptions`, serviceRoleKey, {
        method: 'POST',
        body: JSON.stringify({
          user_id: body.user_id,
          item_name: body.item_name,
          cost: body.cost,
          status: 'pending',
          created_at: new Date().toISOString()
        })
      });
      
      return new Response(JSON.stringify({
        success: true,
        message: `成功兑换${body.item_name}！`,
        newBalance: result.newBalance
      }), {
        headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: '请求格式错误' }), {
        status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // GET /api/announcements - 获取公告列表
  if (path === '/api/announcements' && request.method === 'GET') {
    try {
      const announcementsUrl = `${supabaseUrl}/rest/v1/job_announcements?select=*&order=is_hot.desc,published_at.desc`;
      const resp = await supabaseRequest(announcementsUrl, serviceRoleKey);
      const announcements = await resp.json();
      
      return new Response(JSON.stringify({
        success: true,
        data: announcements,
        count: announcements.length
      }), {
        headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: '获取公告失败', details: e instanceof Error ? e.message : '未知错误' }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // POST /api/announcements - 新增公告
  if (path === '/api/announcements' && request.method === 'POST') {
    try {
      const body = await request.json() as {
        title: string;
        category?: string;
        location?: string;
        education?: string;
        deadline?: string;
        salary?: string;
        link?: string;
        is_hot?: boolean;
        source?: string;
      };

      if (!body.title) {
        return new Response(JSON.stringify({ error: '缺少title参数' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }

      const newAnnouncement = {
        title: body.title,
        category: body.category || '人才引进',
        location: body.location || '广东',
        education: body.education || '硕士',
        deadline: body.deadline || '长期有效',
        salary: body.salary || '面议',
        link: body.link || null,
        is_hot: body.is_hot || false,
        source: body.source || 'we-aigo平台',
        published_at: new Date().toISOString()
      };

      const resp = await supabaseRequest(`${supabaseUrl}/rest/v1/job_announcements`, serviceRoleKey, {
        method: 'POST',
        body: JSON.stringify(newAnnouncement),
        headers: { 'Prefer': 'return=representation' }
      });

      const created = await resp.json();

      return new Response(JSON.stringify({
        success: true,
        message: '公告创建成功',
        data: created
      }), {
        status: 201, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: '创建公告失败', details: e instanceof Error ? e.message : '未知错误' }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // GET /api/token/history?user_id=X
  if (path === '/api/token/history' && request.method === 'GET') {
    const userId = parseInt(url.searchParams.get('user_id') || '0');
    if (!userId) {
      return new Response(JSON.stringify({ error: '缺少user_id参数' }), {
        status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
    
    const history = await getTokenHistory(userId, supabaseUrl, serviceRoleKey);
    return new Response(JSON.stringify({ success: true, userId, history }), {
      headers: { ...corsHeaders, 'Content-Type': 'application/json' }
    });
  }

  // ============ 宠物系统 API ============
  
  // 初始化宠物表 - 使用Supabase Management API
  if (path === '/api/pet/init' && request.method === 'POST') {
    try {
      const managementApiUrl = 'https://api.supabase.com/v1/projects/mzjmfyoemcsoqzoooiej/database/query';
      const managementResponse = await fetch(managementApiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${serviceRoleKey}`
        },
        body: JSON.stringify({
          query: `CREATE TABLE IF NOT EXISTS user_pets (
            id SERIAL PRIMARY KEY,
            user_id INTEGER NOT NULL,
            pet_type VARCHAR(20) NOT NULL,
            pet_name VARCHAR(50) NOT NULL,
            level INTEGER DEFAULT 1,
            exp INTEGER DEFAULT 0,
            mood INTEGER DEFAULT 80,
            hunger INTEGER DEFAULT 80,
            last_fed TIMESTAMPTZ,
            last_played TIMESTAMPTZ,
            last_cleaned TIMESTAMPTZ,
            last_check_in TIMESTAMPTZ,
            created_at TIMESTAMPTZ DEFAULT NOW(),
            UNIQUE(user_id)
          );`
        })
      });
      
      const result = await managementResponse.json();
      if (managementResponse.ok) {
        return new Response(JSON.stringify({ success: true, message: '宠物表创建成功' }), {
          headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      } else {
        return new Response(JSON.stringify({ success: false, error: result }), {
          status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
    } catch (e) {
      return new Response(JSON.stringify({ error: e instanceof Error ? e.message : '未知错误' }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // GET /api/pet?user_id=X - 获取用户宠物信息
  if (path === '/api/pet' && request.method === 'GET') {
    const userId = parseInt(url.searchParams.get('user_id') || '0');
    if (!userId) {
      return new Response(JSON.stringify({ error: '缺少user_id参数' }), {
        status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
    
    try {
      const petUrl = `${supabaseUrl}/rest/v1/user_pets?user_id=eq.${userId}&select=*`;
      const resp = await supabaseRequest(petUrl, serviceRoleKey);
      const pets = await resp.json();
      
      if (!pets || pets.length === 0) {
        return new Response(JSON.stringify({ success: true, hasPet: false, pet: null }), {
          headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      const pet = pets[0];
      const now = new Date();
      
      // 计算属性衰减
      const calcDecay = (lastTime: string | null, decayPerHour: number): number => {
        if (!lastTime) return 0;
        const last = new Date(lastTime);
        const hours = (now.getTime() - last.getTime()) / (1000 * 60 * 60);
        return Math.min(100, Math.max(0, Math.floor(hours * decayPerHour)));
      };
      
      // 获取最后互动时间（取三个时间的最大值）
      const lastInteraction = [pet.last_fed, pet.last_played, pet.last_cleaned, pet.created_at]
        .filter(Boolean)
        .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())[0];
      
      const moodDecay = calcDecay(lastInteraction, 2);
      const hungerDecay = calcDecay(lastInteraction, 3);
      
      // 应用衰减
      const currentMood = Math.max(0, pet.mood - moodDecay);
      const currentHunger = Math.max(0, pet.hunger - hungerDecay);
      
      // 计算冷却时间
      const getCooldown = (lastTime: string | null, cooldownHours: number): { onCooldown: boolean; remaining: number } => {
        if (!lastTime) return { onCooldown: false, remaining: 0 };
        const last = new Date(lastTime);
        const diff = now.getTime() - last.getTime();
        const cooldownMs = cooldownHours * 60 * 60 * 1000;
        const remaining = Math.max(0, cooldownMs - diff);
        return {
          onCooldown: remaining > 0,
          remaining: Math.ceil(remaining / 1000) // 返回秒数
        };
      };
      
      const feedCooldown = getCooldown(pet.last_fed, 2);
      const playCooldown = getCooldown(pet.last_played, 3);
      const cleanCooldown = getCooldown(pet.last_cleaned, 4);
      const checkInCooldown = getCooldown(pet.last_check_in, 24);
      
      // 获取最近5条互动记录
      const historyUrl = `${supabaseUrl}/rest/v1/token_transactions?user_id=eq.${userId}&type=like.pet%25&order=created_at.desc&limit=5&select=type,amount,created_at`;
      const historyResp = await supabaseRequest(historyUrl, serviceRoleKey);
      const history = await historyResp.json();
      
      return new Response(JSON.stringify({
        success: true,
        hasPet: true,
        pet: {
          id: pet.id,
          pet_type: pet.pet_type,
          pet_name: pet.pet_name,
          level: pet.level,
          exp: pet.exp,
          mood: currentMood,
          hunger: currentHunger,
          cooldowns: {
            feed: feedCooldown,
            play: playCooldown,
            clean: cleanCooldown,
            checkIn: checkInCooldown
          },
          history: history || []
        }
      }), {
        headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: e instanceof Error ? e.message : '未知错误' }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // POST /api/pet/adopt - 领养宠物
  if (path === '/api/pet/adopt' && request.method === 'POST') {
    try {
      const body = await request.json() as { user_id: number; pet_type: string; pet_name: string };
      
      if (!body.user_id || !body.pet_type || !body.pet_name) {
        return new Response(JSON.stringify({ error: '缺少必填参数' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      const validTypes = ['cat', 'rabbit', 'fox'];
      if (!validTypes.includes(body.pet_type)) {
        return new Response(JSON.stringify({ error: '无效的宠物类型' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 检查是否已有宠物
      const checkUrl = `${supabaseUrl}/rest/v1/user_pets?user_id=eq.${body.user_id}&select=id`;
      const checkResp = await supabaseRequest(checkUrl, serviceRoleKey);
      const existing = await checkResp.json();
      
      if (existing && existing.length > 0) {
        return new Response(JSON.stringify({ success: false, error: '你已领养过宠物了' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 创建宠物
      const createUrl = `${supabaseUrl}/rest/v1/user_pets`;
      const createResp = await supabaseRequest(createUrl, serviceRoleKey, {
        method: 'POST',
        body: JSON.stringify({
          user_id: body.user_id,
          pet_type: body.pet_type,
          pet_name: body.pet_name,
          level: 1,
          exp: 0,
          mood: 80,
          hunger: 80,
          created_at: new Date().toISOString()
        }),
        headers: { 'Prefer': 'return=representation' }
      });
      
      const created = await createResp.json();
      
      return new Response(JSON.stringify({
        success: true,
        message: `恭喜！成功领养${body.pet_name}！`,
        pet: created[0]
      }), {
        status: 201, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: e instanceof Error ? e.message : '未知错误' }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  // POST /api/pet/interact - 宠物互动（喂食/玩耍/清洁/签到）
  if (path === '/api/pet/interact' && request.method === 'POST') {
    try {
      const body = await request.json() as { user_id: number; action: string };
      
      if (!body.user_id || !body.action) {
        return new Response(JSON.stringify({ error: '缺少必填参数' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      const actionConfig: Record<string, { tokens: number; exp: number; moodChange: number; hungerChange: number; cooldownHours: number }> = {
        feed: { tokens: 15, exp: 5, moodChange: 5, hungerChange: 25, cooldownHours: 2 },
        play: { tokens: 10, exp: 5, moodChange: 25, hungerChange: -5, cooldownHours: 3 },
        clean: { tokens: 5, exp: 3, moodChange: 10, hungerChange: 5, cooldownHours: 4 },
        checkin: { tokens: 50, exp: 10, moodChange: 10, hungerChange: 10, cooldownHours: 24 }
      };
      
      const config = actionConfig[body.action];
      if (!config) {
        return new Response(JSON.stringify({ error: '无效的互动动作' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      // 获取宠物
      const petUrl = `${supabaseUrl}/rest/v1/user_pets?user_id=eq.${body.user_id}&select=*`;
      const petResp = await supabaseRequest(petUrl, serviceRoleKey);
      const pets = await petResp.json();
      
      if (!pets || pets.length === 0) {
        return new Response(JSON.stringify({ success: false, error: '你还没有领养宠物' }), {
          status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
      
      const pet = pets[0];
      const now = new Date();
      const lastActionKey = body.action === 'feed' ? 'last_fed' : 
                           body.action === 'play' ? 'last_played' : 
                           body.action === 'clean' ? 'last_cleaned' : 'last_check_in';
      const lastActionTime = pet[lastActionKey];
      
      // 检查冷却
      if (lastActionTime) {
        const lastTime = new Date(lastActionTime);
        const diff = now.getTime() - lastTime.getTime();
        const cooldownMs = config.cooldownHours * 60 * 60 * 1000;
        if (diff < cooldownMs) {
          const remaining = Math.ceil((cooldownMs - diff) / 1000);
          return new Response(JSON.stringify({
            success: false,
            error: '还在冷却中',
            remainingSeconds: remaining,
            message: `请等待 ${Math.ceil(remaining / 60)} 分钟后重试`
          }), {
            status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
          });
        }
      }
      
      // 更新宠物属性
      const newMood = Math.min(100, Math.max(0, pet.mood + config.moodChange));
      const newHunger = Math.min(100, Math.max(0, pet.hunger + config.hungerChange));
      const newExp = pet.exp + config.exp;
      
      // 检查升级
      const expNeeded = pet.level * 20;
      let newLevel = pet.level;
      let leveledUp = false;
      let bonusTokens = 0;
      
      if (newExp >= expNeeded) {
        newLevel = pet.level + 1;
        leveledUp = true;
        bonusTokens = 100; // 升级奖励
      }
      
      // 更新数据库
      const updateData: any = {
        mood: newMood,
        hunger: newHunger,
        exp: newExp,
        level: newLevel,
        [lastActionKey]: now.toISOString()
      };
      
      await supabaseRequest(`${supabaseUrl}/rest/v1/user_pets?user_id=eq.${body.user_id}`, serviceRoleKey, {
        method: 'PATCH',
        body: JSON.stringify(updateData)
      });
      
      // 添加省钱币
      const totalTokens = config.tokens + bonusTokens;
      await addTokenTransaction(
        body.user_id,
        totalTokens,
        `pet_${body.action}`,
        `宠物${body.action === 'checkin' ? '签到' : body.action === 'feed' ? '喂食' : body.action === 'play' ? '玩耍' : '清洁'}奖励`,
        undefined,
        supabaseUrl,
        serviceRoleKey
      );
      
      const newBalance = await getTokenBalance(body.user_id, supabaseUrl, serviceRoleKey);
      
      return new Response(JSON.stringify({
        success: true,
        message: leveledUp 
          ? `太棒了！宠物升到${newLevel}级！获得+${totalTokens}省钱币` 
          : `恭喜！获得+${config.tokens}省钱币`,
        earned: totalTokens,
        leveledUp,
        newLevel,
        newBalance,
        pet: {
          mood: newMood,
          hunger: newHunger,
          exp: newExp,
          level: newLevel
        },
        nextCooldownSeconds: config.cooldownHours * 3600
      }), {
        headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: e instanceof Error ? e.message : '未知错误' }), {
        status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
      });
    }
  }

  return new Response(JSON.stringify({ error: '未知API路径' }), {
    status: 404, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
  });
}

  // 健康检查
  if (path === '/health' && request.method === 'GET') {
    return new Response(
      JSON.stringify({ status: 'ok', timestamp: new Date().toISOString() }),
      { headers: { 'Content-Type': 'application/json' } }
    );
  }

  // 默认返回路由信息
  return new Response(
    JSON.stringify({ 
      message: 'we-aigo Worker API',
      routes: ['POST /execute', 'POST /api/auto-execute', 'GET /health', '/api/token/*']
    }),
    { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
  );
}

// 导出处理函数
export default {
  async fetch(request: Request, env: any): Promise<Response> {
    return handleRequest(request, env);
  },
  
  // Cloudflare Cron 定时触发
  async scheduled(controller: ScheduledController, env: any): Promise<void> {
    await handleScheduled(env);
    controller.close();
  }
};
