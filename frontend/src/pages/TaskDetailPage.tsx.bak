import React, { useState } from "react";
import { useParams, useNavigate } from "react-router-dom";

/* =========================
   🚀 模拟任务数据（实际可接后端）
========================= */
const taskData: any = {
  1: {
    title: "英语阅读主线任务",
    zone: "🔴 英语核心区",
    xp: 50,
    description: "提升英语阅读理解能力",
  },
  2: {
    title: "语法强化支线任务",
    zone: "🟠 语法实验室",
    xp: 30,
    description: "掌握英语语法结构",
  },
  3: {
    title: "听力挑战任务",
    zone: "🔵 听力站",
    xp: 40,
    description: "训练英语听力理解",
  },
};

/* =========================
   🚀 AI模拟（后面可接DeepSeek）
========================= */
function mockAIExplain(task: any) {
  return `
🧠 AI讲解：

本任务属于【${task.zone}】

学习目标：
${task.description}

学习步骤：
1. 理解基础概念
2. 阅读示例
3. 完成练习
4. AI自动检查

提示：
先不要急着做题，先理解结构。
`;
}

/* =========================
   🚀 主页面
========================= */
export default function TaskDetailPage() {
  const { id } = useParams();
  const navigate = useNavigate();

  const task = taskData[id as any];

  const [step, setStep] = useState(1);
  const [answer, setAnswer] = useState("");
  const [result, setResult] = useState("");

  if (!task) {
    return (
      <div style={styles.page}>
        <div style={styles.card}>任务不存在</div>
      </div>
    );
  }

  /* =========================
     🚀 AI评分模拟（后续接GPT）
  ========================= */
  const handleSubmit = () => {
    if (!answer) {
      setResult("❌ 请输入答案");
      return;
    }

    const score = Math.floor(Math.random() * 40) + 60;

    setResult(
      `🎉 完成任务！\n\n评分：${score}/100\nXP +${task.xp}\n\nAI建议：继续强化该知识点`
    );
  };

  return (
    <div style={styles.page}>

      {/* HEADER */}
      <div style={styles.header}>
        <div style={styles.title}>🚀 火星基地任务执行器</div>
        <div style={styles.sub}>{task.zone}</div>
      </div>

      {/* TASK INFO */}
      <div style={styles.card}>
        <h2>{task.title}</h2>
        <p>{task.description}</p>
        <p>⚡ XP奖励：{task.xp}</p>
      </div>

      {/* AI EXPLAIN */}
      <div style={styles.aiBox}>
        <h3>🤖 AI指挥官讲解</h3>
        <pre style={styles.pre}>
          {mockAIExplain(task)}
        </pre>
      </div>

      {/* STEP SYSTEM */}
      <div style={styles.card}>
        <h3>📡 学习步骤</h3>

        <div style={styles.steps}>
          <div style={step >= 1 ? styles.activeStep : styles.step}>1 理解</div>
          <div style={step >= 2 ? styles.activeStep : styles.step}>2 练习</div>
          <div style={step >= 3 ? styles.activeStep : styles.step}>3 作答</div>
        </div>

        <button onClick={() => setStep(step + 1)} style={styles.btn}>
          下一步
        </button>
      </div>

      {/* INPUT AREA */}
      {step >= 3 && (
        <div style={styles.card}>
          <h3>✍️ 你的回答</h3>

          <textarea
            style={styles.textarea}
            value={answer}
            onChange={(e) => setAnswer(e.target.value)}
            placeholder="请输入你的答案..."
          />

          <button onClick={handleSubmit} style={styles.btn}>
            🚀 提交给AI评分
          </button>

          {result && <pre style={styles.result}>{result}</pre>}
        </div>
      )}

      {/* BACK */}
      <button onClick={() => navigate("/tasks")} style={styles.back}>
        ← 返回火星基地
      </button>
    </div>
  );
}

/* =========================
   🎨 STYLE（火星基地风格）
========================= */
const styles: any = {
  page: {
    minHeight: "100vh",
    background: "linear-gradient(180deg,#070A12,#050814)",
    color: "#fff",
    padding: "20px",
    fontFamily: "Inter, PingFang SC, sans-serif",
  },

  header: {
    textAlign: "center",
    marginBottom: "20px",
  },

  title: {
    fontSize: "28px",
    fontWeight: "bold",
  },

  sub: {
    opacity: 0.7,
  },

  card: {
    background: "rgba(255,255,255,0.06)",
    padding: "15px",
    borderRadius: "12px",
    marginBottom: "15px",
    border: "1px solid rgba(255,255,255,0.1)",
  },

  aiBox: {
    background: "rgba(0,180,255,0.08)",
    padding: "15px",
    borderRadius: "12px",
    marginBottom: "15px",
  },

  pre: {
    whiteSpace: "pre-wrap",
    fontSize: "13px",
    opacity: 0.9,
  },

  steps: {
    display: "flex",
    gap: "10px",
    marginBottom: "10px",
  },

  step: {
    padding: "5px 10px",
    background: "#222",
    borderRadius: "6px",
    fontSize: "12px",
  },

  activeStep: {
    padding: "5px 10px",
    background: "#4cafef",
    borderRadius: "6px",
    fontSize: "12px",
  },

  textarea: {
    width: "100%",
    height: "100px",
    marginTop: "10px",
    borderRadius: "8px",
    padding: "10px",
  },

  btn: {
    marginTop: "10px",
    width: "100%",
    padding: "10px",
    background: "#4cafef",
    border: "none",
    borderRadius: "8px",
    color: "#fff",
  },

  result: {
    marginTop: "10px",
    whiteSpace: "pre-wrap",
    fontSize: "13px",
  },

  back: {
    marginTop: "20px",
    background: "transparent",
    color: "#fff",
    border: "1px solid #555",
    padding: "10px",
    borderRadius: "8px",
    width: "100%",
  },
};